# انسخ هذا الملف باسم .env وعبّي القيم

# من Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# من General Information > Application ID
CLIENT_ID=

# من OAuth2 > Client Secret
CLIENT_SECRET=

# رابط الموقع. محلياً خليه هيك. على استضافة حط رابط موقعك (https://...)
BASE_URL=http://localhost:3000
PORT=3000

# أي نص عشوائي طويل (بيحمي جلسات تسجيل الدخول)
SESSION_SECRET=change-me-to-a-long-random-string

# آيدي حسابك بديسكورد (صاحب البوت). ممكن أكثر من آيدي بفاصلة. بيفتح لك "لوحة المالك"
OWNER_ID=

# (اختياري) تخزين دائم بـ Supabase. مهم على ريندر وأمثاله لأن ملفاتها بتنمسح. شوف README
SUPABASE_URL=
SUPABASE_KEY=
